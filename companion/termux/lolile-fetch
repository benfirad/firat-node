#!/data/data/com.termux/files/usr/bin/python
from __future__ import annotations

import base64
import os
import pathlib
import subprocess
import sys
import tempfile


ROOT = "smb://lolile/kurek"
SHARE = f"//{os.environ.get('DAAK_LOLILE_SMB_HOST', '100.69.25.110')}/kurek"
AUTH = pathlib.Path.home() / ".config" / "daak" / "smb-credentials"
DOWNLOADS = pathlib.Path("/sdcard/Download/DAAK-Kurek")


def decode_file(value: str) -> tuple[str, str]:
    try:
        path = base64.b64decode(value, validate=True).decode("utf-8")
    except Exception as error:
        raise ValueError("invalid path") from error
    if not path.startswith(ROOT + "/"):
        raise ValueError("outside Kurek")
    parts = [part for part in path[len(ROOT) + 1 :].split("/") if part]
    if not parts or any(part in (".", "..") or "\x00" in part for part in parts):
        raise ValueError("unsafe path")
    return "/".join(parts[:-1]), parts[-1]


def smb_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def atomic_status(target: pathlib.Path, line: str) -> None:
    temporary = target.with_name(target.name + f".{os.getpid()}.tmp")
    temporary.write_text(line + "\n", encoding="utf-8")
    temporary.replace(target)


def main() -> int:
    encoded = sys.argv[1] if len(sys.argv) > 1 else ""
    token = sys.argv[2] if len(sys.argv) > 2 else "0"
    status = pathlib.Path(f"/sdcard/Download/daak-lolile-fetch-{token}.txt")
    try:
        parent, name = decode_file(encoded)
        DOWNLOADS.mkdir(parents=True, exist_ok=True)
        local = DOWNLOADS / name
        descriptor, temporary_name = tempfile.mkstemp(prefix=".daak-", suffix=".part", dir=DOWNLOADS)
        os.close(descriptor)
        temporary = pathlib.Path(temporary_name)
        command = [
            "smbclient", SHARE, "-A", str(AUTH), "-m", "SMB3",
            "--client-protection=encrypt",
        ]
        if parent:
            command.extend(["-D", parent])
        command.extend(["-c", f"get {smb_quote(name)} {smb_quote(str(temporary))}"])
        try:
            subprocess.run(command, capture_output=True, text=True, timeout=45, check=True)
            if not temporary.is_file():
                raise FileNotFoundError(name)
            temporary.replace(local)
        finally:
            temporary.unlink(missing_ok=True)
        if not local.is_file():
            raise FileNotFoundError(name)
        atomic_status(status, f"[OK] {local}")
        return 0
    except Exception:
        atomic_status(status, "[ERR] download failed")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
