#!/data/data/com.termux/files/usr/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: daak-open [--cromite|--firefox|--system] <url>

Open an HTTP(S) link from Termux in an Android browser.
Bare domains such as example.com are upgraded to https://example.com.
EOF
}

browser="${DAAK_BROWSER:-org.cromite.cromite}"
case "${1:-}" in
    --cromite) browser="org.cromite.cromite"; shift ;;
    --firefox) browser="org.mozilla.fennec_fdroid"; shift ;;
    --system) browser=""; shift ;;
    -h|--help) usage; exit 0 ;;
esac

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

url=$1
case "$url" in
    http://*|https://*) ;;
    *://*)
        echo "daak-open: only http:// and https:// links are allowed" >&2
        exit 2
        ;;
    *.*) url="https://$url" ;;
    *)
        echo "daak-open: enter a complete URL or domain" >&2
        exit 2
        ;;
esac

case "${TERMUX__USER_ID:-}" in
    ''|*[!0-9]*|0[0-9]*) android_user=0 ;;
    *) android_user=$TERMUX__USER_ID ;;
esac

if command -v am >/dev/null 2>&1; then
    android_am=am
elif [ -x /system/bin/am ]; then
    android_am=/system/bin/am
else
    echo "daak-open: Android activity manager is unavailable" >&2
    exit 1
fi

open_system() {
    "$android_am" start --user "$android_user" \
        -a android.intent.action.VIEW \
        -c android.intent.category.BROWSABLE \
        -d "$url" >/dev/null
}

if [ -n "$browser" ]; then
    if ! "$android_am" start --user "$android_user" \
        -a android.intent.action.VIEW \
        -c android.intent.category.BROWSABLE \
        -d "$url" -p "$browser" >/dev/null 2>&1; then
        open_system
    fi
else
    open_system
fi

printf 'DAAK // opened %s\n' "$url"
