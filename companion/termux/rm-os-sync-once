#!/data/data/com.termux/files/usr/bin/python
from __future__ import annotations

import base64
import datetime as dt
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
import zipfile


HOME = pathlib.Path("/data/data/com.termux/files/home")
VAULT = pathlib.Path("/sdcard/Documents/DAAK-Vault")
MIRROR = VAULT / "RM-OS"
CAPTURE = VAULT / "RM-OS Capture.md"
CODEX_OUTBOX = VAULT / "Codex Outbox"
STATUS = VAULT / "RM-OS Sync Status.md"
LOCK = HOME / ".cache" / "daak-rm-os-sync.lock"
LOCK_MAX_AGE = 15 * 60
CAPTURE_MARKER = "<!-- DAAK_SYNC_BELOW -->"
CAPTURE_HEADER = (
    "# RM-OS Capture\n\n"
    "> Buraya yazılanlar güvenli kuyrukla `B:\\RM-OS\\INBOX\\notes\\phone` içine taşınır.\n"
    "> Parola, API anahtarı, banka veya kimlik bilgisi yazma.\n\n"
    f"{CAPTURE_MARKER}\n"
)

ROOT_FILES = (
    "AGENT_POLICY.md", "AGENTS.md", "CLAUDE.md", "IDENTITY.md", "MEMORY.md",
    "STATE.md", "USER.md", "RULES.md", "README.md", "MANIFEST.json",
)
TREE_PATHS = (
    "SHARED_WITH_AI", "BUSINESSES", "CLIENTS", "PROJECTS", "VEHICLES",
    "ACCOUNTING", "DEVICES", "EDUCATION_IMMIGRATION", "REVIEWS", "AI_OUTPUT",
)


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    result = subprocess.run(command, text=True, errors="replace", **kwargs)
    if result.returncode:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        suffix = f": {detail[-1]}" if detail else ""
        raise RuntimeError(f"{pathlib.Path(command[0]).name} exited {result.returncode}{suffix}")
    return result


def powershell(script: str) -> None:
    encoded = base64.b64encode(script.encode("utf-16le")).decode("ascii")
    run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "lolile",
         "powershell.exe", "-NoProfile", "-EncodedCommand", encoded],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


def sftp(batch: str, cwd: pathlib.Path) -> None:
    run(["sftp", "-q", "-b", "-", "lolile"], input=batch, cwd=str(cwd),
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


def ensure_layout() -> None:
    VAULT.mkdir(parents=True, exist_ok=True)
    CODEX_OUTBOX.mkdir(parents=True, exist_ok=True)
    (CODEX_OUTBOX / "Sent").mkdir(parents=True, exist_ok=True)
    if not CAPTURE.exists():
        CAPTURE.write_text(CAPTURE_HEADER, encoding="utf-8")


def acquire_lock() -> bool:
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    try:
        LOCK.mkdir()
    except FileExistsError:
        owner = LOCK / "owner"
        try:
            values = dict(line.split("=", 1) for line in owner.read_text(encoding="utf-8").splitlines() if "=" in line)
            owner_pid = int(values.get("pid", "0"))
            command = pathlib.Path(f"/proc/{owner_pid}/cmdline").read_bytes().replace(b"\0", b" ")
            if b"rm-os-sync-once" in command:
                return False
        except (OSError, ValueError):
            pass
        try:
            age = time.time() - LOCK.stat().st_mtime
        except OSError:
            return False
        if age < LOCK_MAX_AGE:
            return False
        shutil.rmtree(LOCK, ignore_errors=True)
        try:
            LOCK.mkdir()
        except FileExistsError:
            return False
    (LOCK / "owner").write_text(f"pid={os.getpid()}\nstarted={now_iso()}\n", encoding="utf-8")
    return True


def upload_capture() -> bool:
    raw = CAPTURE.read_text(encoding="utf-8") if CAPTURE.exists() else CAPTURE_HEADER
    body = raw.split(CAPTURE_MARKER, 1)[-1].strip()
    if not body:
        return False
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    local = HOME / ".cache" / f"rm-os-phone-{stamp}.md"
    local.parent.mkdir(parents=True, exist_ok=True)
    local.write_text(
        f"# DAAK NODE Capture\n\n- Kaynak: Obsidian / DAAK Inbox\n- Tarih: {now_iso()}\n\n{body}\n",
        encoding="utf-8",
    )
    remote_dir = r"B:\RM-OS\INBOX\notes\phone"
    powershell(
        "$ErrorActionPreference='Stop';"
        f"$d='{remote_dir}';New-Item -ItemType Directory -Force -Path $d|Out-Null"
    )
    try:
        sftp(f"put {local} /B:/RM-OS/INBOX/notes/phone/{local.name}\n", HOME)
    finally:
        local.unlink(missing_ok=True)
    CAPTURE.write_text(CAPTURE_HEADER, encoding="utf-8")
    return True


def upload_codex_outbox() -> int:
    files = sorted(p for p in CODEX_OUTBOX.glob("*.md") if p.is_file())
    if not files:
        return 0
    powershell(
        "$ErrorActionPreference='Stop';"
        "$d='B:\\RM-OS\\AI_OUTPUT\\CODEX';"
        "New-Item -ItemType Directory -Force -Path $d|Out-Null"
    )
    sent = 0
    for path in files:
        safe_name = "".join(c for c in path.name if c.isalnum() or c in "._-")
        if safe_name != path.name:
            continue
        sftp(f'put "{path}" /B:/RM-OS/AI_OUTPUT/CODEX/{safe_name}\n', HOME)
        path.replace(CODEX_OUTBOX / "Sent" / safe_name)
        sent += 1
    return sent


def pull_allowed_snapshot() -> int:
    stage = VAULT / f".rm-os-staging-{os.getpid()}"
    backup = VAULT / ".rm-os-previous"
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(parents=True)
    (stage / "KNOWLEDGE").mkdir()
    commands = [f"get /B:/RM-OS/{name} {name}" for name in ROOT_FILES]
    commands.extend(f"get -R /B:/RM-OS/{name}" for name in TREE_PATHS)
    commands.append("get /B:/RM-OS/KNOWLEDGE/FACTS.jsonl KNOWLEDGE/FACTS.jsonl")
    try:
        sftp("\n".join(commands) + "\n", stage)
        file_count = sum(1 for p in stage.rglob("*") if p.is_file())
        (stage / "_SYNC.md").write_text(
            "# RM-OS Safe Mirror\n\n"
            f"- Son senkron: {now_iso()}\n- Kaynak: `B:\\RM-OS`\n"
            f"- Dosya: {file_count}\n- Mod: izinli yollar, salt-okunur ayna\n\n"
            "`PRIVATE`, `.env`, anahtarlar, credential depoları, `AI_INBOX` ve loglar bu aynaya alınmaz.\n",
            encoding="utf-8",
        )
        if backup.exists():
            shutil.rmtree(backup)
        if MIRROR.exists():
            MIRROR.replace(backup)
        try:
            stage.replace(MIRROR)
        except Exception:
            if backup.exists() and not MIRROR.exists():
                backup.replace(MIRROR)
            raise
        if backup.exists():
            shutil.rmtree(backup)
        return file_count
    except Exception:
        if stage.exists():
            shutil.rmtree(stage)
        raise


def write_status(ok: bool, detail: str) -> None:
    STATUS.write_text(
        "# RM-OS Sync Status\n\n"
        f"- Durum: {'ONLINE' if ok else 'OFFLINE'}\n"
        f"- Zaman: {now_iso()}\n"
        f"- Detay: {detail}\n"
        "- Güvenlik: Tailnet + Ed25519; gizli yollar hariç\n",
        encoding="utf-8",
    )


def build_rm_archive() -> None:
    if not MIRROR.exists():
        return
    target = VAULT / ".rm-os-safe.zip"
    temporary = VAULT / ".rm-os-safe.zip.tmp"
    with zipfile.ZipFile(temporary, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(p for p in MIRROR.rglob("*") if p.is_file() and not p.is_symlink()):
            archive.write(path, path.relative_to(MIRROR).as_posix())
    temporary.replace(target)


def build_obsidian_archive() -> None:
    target = VAULT / ".obsidian-safe.zip"
    temporary = VAULT / ".obsidian-safe.zip.tmp"
    with zipfile.ZipFile(temporary, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(p for p in VAULT.glob("*.md") if p.is_file() and not p.is_symlink()):
            archive.write(path, path.name)
    temporary.replace(target)


def log_remote(capture_uploaded: bool, codex_uploaded: int, files: int) -> None:
    record = json.dumps({
        "timestamp": now_iso(), "action": "obsidian_safe_sync", "source": "DAAK NODE",
        "target": "B:\\RM-OS + DAAK-Vault", "permission_level": 1,
        "user_approval": True, "result": "ok", "files": files,
        "capture_uploaded": capture_uploaded, "codex_outputs_uploaded": codex_uploaded,
    }, ensure_ascii=False)
    encoded = base64.b64encode(record.encode("utf-8")).decode("ascii")
    powershell(
        "$ErrorActionPreference='Stop';"
        f"$j=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{encoded}'));"
        "$p='B:\\RM-OS\\LOGS\\activity.jsonl';"
        "[IO.File]::AppendAllText($p,$j+[Environment]::NewLine,(New-Object Text.UTF8Encoding($false)))"
    )


def main() -> int:
    if not acquire_lock():
        return 0
    try:
        ensure_layout()
        build_obsidian_archive()
        capture_uploaded = upload_capture()
        codex_uploaded = upload_codex_outbox()
        files = pull_allowed_snapshot()
        build_rm_archive()
        build_obsidian_archive()
        audit = "remote"
        try:
            log_remote(capture_uploaded, codex_uploaded, files)
        except Exception:
            audit = "local"
        write_status(True, f"{files} dosya • capture={int(capture_uploaded)} • codex={codex_uploaded} • audit={audit}")
        return 0
    except Exception as error:
        build_obsidian_archive()
        write_status(False, f"{type(error).__name__}: {error}")
        print(f"RM-OS sync failed: {error}", file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(LOCK, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
