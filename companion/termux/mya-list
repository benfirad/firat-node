#!/data/data/com.termux/files/usr/bin/python
from __future__ import annotations

import base64
import os
import pathlib
import re
import shlex
import subprocess
import sys


ROOT = "sftp://mya-l11/ServerShare"
HOST = os.environ.get("DAAK_MYA_SSH_HOST", "mya-l11")
REMOTE_ROOT = os.environ.get("DAAK_MYA_SHARE_ROOT", "/Users/mac/ServerShare")
DEFAULT_TARGET = pathlib.Path("/sdcard/Download/daak-mya-list.txt")
REMOTE_LIST = r"""
import base64
import pathlib
import sys

root = pathlib.Path(sys.argv[1]).resolve()
relative = base64.urlsafe_b64decode(sys.argv[2].encode("ascii")).decode("utf-8")
target = (root / relative).resolve()
target.relative_to(root)
if not target.is_dir():
    raise NotADirectoryError(relative)
for child in sorted(target.iterdir(), key=lambda item: (not item.is_dir(), item.name.casefold())):
    if child.name.startswith(".") or "\n" in child.name or "\r" in child.name:
        continue
    kind = "D" if child.is_dir() else "F"
    encoded = base64.urlsafe_b64encode(child.name.encode("utf-8")).decode("ascii")
    print(kind + "\t" + encoded)
"""


def decode_path(value: str) -> str:
    if not value:
        return ROOT
    try:
        path = base64.b64decode(value, validate=True).decode("utf-8")
    except Exception:
        return ROOT
    if path == ROOT:
        return ROOT
    if not path.startswith(ROOT + "/"):
        return ROOT
    parts = [part for part in path[len(ROOT) + 1 :].split("/") if part]
    if any(part in (".", "..") or "\x00" in part for part in parts):
        return ROOT
    return ROOT + "/" + "/".join(parts)


def remote_command(relative: str) -> str:
    encoded = base64.urlsafe_b64encode(relative.encode("utf-8")).decode("ascii")
    return "python3 -c {} {} {}".format(
        shlex.quote(REMOTE_LIST), shlex.quote(REMOTE_ROOT), shlex.quote(encoded)
    )


def atomic_write(target: pathlib.Path, lines: list[str]) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + f".{os.getpid()}.tmp")
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    temporary.replace(target)


def main() -> int:
    path = decode_path(sys.argv[1] if len(sys.argv) > 1 else "")
    request = sys.argv[2] if len(sys.argv) > 2 else "0"
    target = pathlib.Path(sys.argv[3]) if len(sys.argv) > 3 else DEFAULT_TARGET
    relative = path[len(ROOT) :].strip("/")
    command = [
        "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
        "-o", "ServerAliveInterval=15", HOST, remote_command(relative),
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=20, check=True)
        items: list[tuple[bool, str]] = []
        for raw in result.stdout.splitlines():
            try:
                kind, encoded_name = raw.split("\t", 1)
                name = base64.urlsafe_b64decode(encoded_name.encode("ascii")).decode("utf-8")
            except Exception:
                continue
            if kind not in ("D", "F") or not name or name in (".", ".."):
                continue
            items.append((kind == "D", name))
        items.sort(key=lambda item: (not item[0], item[1].casefold()))
        output = [f"[P] {path}"]
        output.extend(("[D] " if folder else "[F] ") + name for folder, name in items)
        output.append(f"[OK] {request}")
        atomic_write(target, output)
        return 0
    except Exception as error:
        detail = "offline"
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            lines = [line.strip() for line in error.stderr.splitlines() if line.strip()]
            if lines:
                detail = re.sub(r"[^A-Za-z0-9 ._:/-]", "", lines[-1])[:96] or "offline"
        try:
            atomic_write(target, [f"[P] {path}", f"[ERR] {request} {detail}"])
        except OSError:
            pass
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
