#!/data/data/com.termux/files/usr/bin/python
from __future__ import annotations

import base64
import os
import pathlib
import re
import subprocess
import sys


ROOT = "smb://lolile/kurek"
SHARE = f"//{os.environ.get('DAAK_LOLILE_SMB_HOST', '100.69.25.110')}/kurek"
AUTH = pathlib.Path.home() / ".config" / "daak" / "smb-credentials"
DEFAULT_TARGET = pathlib.Path("/sdcard/Download/daak-lolile-list.txt")
LINE = re.compile(r"^\s{2}(.*?)\s+([A-Z]+)\s+(\d+)\s+\w{3}\s")


def decode_path(value: str) -> str:
    if not value:
        return ROOT
    try:
        path = base64.b64decode(value, validate=True).decode("utf-8")
    except Exception:
        return ROOT
    if path == ROOT:
        return ROOT
    if not path.startswith(ROOT + "/"):
        return ROOT
    parts = [part for part in path[len(ROOT) + 1 :].split("/") if part]
    if any(part in (".", "..") for part in parts):
        return ROOT
    return ROOT + "/" + "/".join(parts)


def atomic_write(target: pathlib.Path, lines: list[str]) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + f".{os.getpid()}.tmp")
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    temporary.replace(target)


def main() -> int:
    path = decode_path(sys.argv[1] if len(sys.argv) > 1 else "")
    request = sys.argv[2] if len(sys.argv) > 2 else "0"
    target = pathlib.Path(sys.argv[3]) if len(sys.argv) > 3 else DEFAULT_TARGET
    relative = path[len(ROOT) :].strip("/")
    command = [
        "smbclient", SHARE, "-A", str(AUTH), "-m", "SMB3",
        "--client-protection=encrypt",
    ]
    if relative:
        command.extend(["-D", relative])
    command.extend(["-c", "ls"])
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=20, check=True)
        items: list[tuple[bool, str]] = []
        for raw in result.stdout.splitlines():
            match = LINE.match(raw)
            if not match:
                continue
            name, flags = match.group(1).rstrip(), match.group(2)
            if name in (".", ".."):
                continue
            items.append(("D" in flags, name))
        items.sort(key=lambda item: (not item[0], item[1].casefold()))
        output = [f"[P] {path}"]
        output.extend(("[D] " if folder else "[F] ") + name for folder, name in items)
        output.append(f"[OK] {request}")
        atomic_write(target, output)
        return 0
    except Exception as error:
        detail = "offline"
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            lines = [line.strip() for line in error.stderr.splitlines() if line.strip()]
            if lines:
                detail = re.sub(r"[^A-Za-z0-9 ._:/-]", "", lines[-1])[:96] or "offline"
        try:
            atomic_write(target, [f"[P] {path}", f"[ERR] {request} {detail}"])
        except OSError:
            pass
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
