#!/data/data/com.termux/files/usr/bin/python
from __future__ import annotations

import datetime as dt
import os
import pathlib
import shutil
import subprocess
import sys
import time
import urllib.parse


HOME = pathlib.Path("/data/data/com.termux/files/home")
VAULT = pathlib.Path("/sdcard/Documents/DAAK-Vault")
REMOTE_FOLDER = "Kitap Meraklısına"
LOCAL = VAULT / REMOTE_FOLDER
STATUS = VAULT / "Kitap Backup Status.md"
LOCK = HOME / ".cache" / "daak-books-sync.lock"
STAMP = HOME / ".cache" / "daak-books-last-success"
RECONCILE_STAMP = HOME / ".cache" / "daak-books-last-reconcile"
AUTH = HOME / ".config" / "daak" / "smb-credentials"
SMBGET_RC = HOME / ".cache" / "daak-books-smbgetrc"
HOST = os.environ.get("DAAK_LOLILE_SMB_HOST", "100.69.25.110")
INITIAL_MIN_FILES = 547
INITIAL_MIN_BYTES = 2_999_692_082


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def local_stats() -> tuple[int, int]:
    files = 0
    size = 0
    if LOCAL.exists():
        for path in LOCAL.rglob("*"):
            if path.is_file() and not path.is_symlink():
                files += 1
                try:
                    size += path.stat().st_size
                except OSError:
                    pass
    return files, size


def write_status(state: str, detail: str) -> None:
    VAULT.mkdir(parents=True, exist_ok=True)
    files, size = local_stats()
    temporary = STATUS.with_suffix(".md.tmp")
    temporary.write_text(
        "# Kitap Meraklısına — Yerel Yedek\n\n"
        f"- Durum: {state}\n"
        f"- Zaman: {now_iso()}\n"
        f"- Yerel dosya: {files}\n"
        f"- Yerel boyut: {size / 1073741824:.2f} GiB\n"
        f"- Detay: {detail}\n"
        "- Kaynak: `smb://lolile/kurek/Kitap Meraklısına`\n"
        "- Mod: SMB3 şifreli, tek yönlü, kaldığı yerden, silme yok\n",
        encoding="utf-8",
    )
    temporary.replace(STATUS)


def credentials() -> tuple[str, str]:
    values: dict[str, str] = {}
    for raw in AUTH.read_text(encoding="utf-8").splitlines():
        if "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        values[key.strip().lower()] = value.strip()
    user = values.get("username", "")
    password = values.get("password", "")
    if not user or not password:
        raise RuntimeError("SMB credentials missing")
    return user, password


def monitor(command: list[str], detail: str, cwd: pathlib.Path) -> None:
    process = subprocess.Popen(command, cwd=str(cwd), stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
    while process.poll() is None:
        time.sleep(20)
        write_status("SENKRONİZE EDİLİYOR", detail)
    if process.returncode != 0:
        raise RuntimeError(f"sync exit {process.returncode}")


def acquire_lock() -> bool:
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    for _ in range(2):
        try:
            LOCK.mkdir()
            (LOCK / "pid").write_text(str(os.getpid()), encoding="ascii")
            return True
        except FileExistsError:
            try:
                owner = int((LOCK / "pid").read_text(encoding="ascii").strip())
                os.kill(owner, 0)
                return False
            except (OSError, ValueError):
                shutil.rmtree(LOCK, ignore_errors=True)
    return False


def main() -> int:
    scheduled_job = "--job" in sys.argv[1:]
    automatic = scheduled_job
    if not acquire_lock():
        return 0
    try:
        VAULT.mkdir(parents=True, exist_ok=True)
        free = shutil.disk_usage(VAULT).free
        if free < 6 * 1024 * 1024 * 1024:
            raise RuntimeError("6 GiB altında boş alan")
        user, password = credentials()
        remote = "smb://" + HOST + "/kurek/" + urllib.parse.quote(REMOTE_FOLDER, safe="")
        write_status("SENKRONİZE EDİLİYOR", "Yeni/değişen kitaplar kontrol ediliyor")
        LOCAL.mkdir(parents=True, exist_ok=True)
        if STAMP.exists():
            changed_command = [
                "smbclient", f"//{HOST}/kurek", "-A", str(AUTH), "-m", "SMB3",
                "--client-protection=encrypt", "-D", REMOTE_FOLDER, "-c",
                f'lcd "{LOCAL}"; newer "{STAMP}"; recurse ON; prompt OFF; mget *',
            ]
            monitor(changed_command, "Son yedekten sonra değişen kitaplar güncelleniyor", LOCAL)
        needs_reconcile = (
            not automatic or not RECONCILE_STAMP.exists() or
            time.time() - RECONCILE_STAMP.stat().st_mtime >= 7 * 24 * 60 * 60
        )
        if needs_reconcile:
            SMBGET_RC.write_text(f"user {user}%{password}\n", encoding="utf-8")
            SMBGET_RC.chmod(0o600)
            missing_command = [
                "smbget", "--rcfile", str(SMBGET_RC), "--nonprompt", "--encrypt",
                "--recursive", "--resume", "--blocksize", "1048576", remote,
            ]
            monitor(missing_command, "Haftalık bütünlük taraması; eksik/yarım kitaplar tamamlanıyor", LOCAL)
            RECONCILE_STAMP.touch()
        files, size = local_stats()
        if files < INITIAL_MIN_FILES or size < INITIAL_MIN_BYTES:
            raise RuntimeError(
                f"yedek eksik: {files}/{INITIAL_MIN_FILES} dosya, "
                f"{size}/{INITIAL_MIN_BYTES} bayt"
            )
        STAMP.touch()
        write_status("HAZIR", f"{files} dosya • {size / 1073741824:.2f} GiB çevrimdışı")
        return 0
    except Exception as error:
        write_status("HATA", f"{type(error).__name__}: {error}")
        return 1
    finally:
        try:
            SMBGET_RC.unlink(missing_ok=True)
        except OSError:
            pass
        shutil.rmtree(LOCK, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
